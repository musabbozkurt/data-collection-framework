# Copy to .env and change the values. Docker Compose reads this file automatically.
MARIADB_ROOT_PASSWORD=change-me-root
DB_NAME=root_db
DB_USER=user
DB_PASSWORD=change-me-user
MONGO_ROOT_PASSWORD=change-me-mongo
MONGO_EXPRESS_PASSWORD=change-me-express

# Python command server (data_collection_framework/server.py)
PY_SERVER_PORT=5555
PY_SERVER_TOKEN=change-me-token

# How PHP talks to the Python back end: rest (default), graphql or tcp (tcp needs `make server` on the host)
API_TRANSPORT=rest
# Linux: uid/gid owning the project folders (run `id -u` / `id -g`) if not 1000
# APP_UID=1000
# APP_GID=1000
