FROM python:3.15.2-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    NLTK_DATA=/usr/share/nltk_data IN_DOCKER=1 SETTINGS_CONFIG_ONLY=1 API_HOST=0.0.0.0
WORKDIR /app

# Dependencies first so code changes do not reinstall them
COPY data_collection_framework/requirements.txt data_collection_framework/requirements.txt
RUN pip install -r data_collection_framework/requirements.txt \
    && python -m nltk.downloader -d "$NLTK_DATA" punkt punkt_tab stopwords \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

COPY data_collection_framework data_collection_framework

# Unprivileged user; data and config folders are mounted from the host (see docker-compose.yml)
RUN useradd --uid 1000 --create-home app \
    && mkdir -p data_collection_framework/data_folders data_collection_framework/x_profile_data \
    && chown -R app:app /app
USER app
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --retries=12 \
    CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health', timeout=4)"
CMD ["python", "data_collection_framework/api_server.py"]
